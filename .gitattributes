# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Maven Wrapper: the POSIX script must stay LF (so it runs under sh in
# WSL/Linux/macOS); the Windows batch wrapper must stay CRLF.
mvnw     text eol=lf
mvnw.cmd text eol=crlf

.github/prepare-release                        text eol=lf
reactions/migration/build-propagation-jars     text eol=lf
reactions/migration/generate-config-matrix     text eol=lf
reactions/preprocessor/preprocess-configs      text eol=lf
