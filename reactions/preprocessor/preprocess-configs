#!/usr/bin/env bash
# Preprocesses the annotated umljava master reactions into configN-reactions
# folders next to the configN.json files, which is what the case study builds
# against.
#
# Usage:
#   ./preprocess-configs          # configs 1..9
#   ./preprocess-configs 1 7      # only the listed configs
#
# The annotated reactions are looked up in the Vitruv-CaseStudies checkout.
# Override with, in order of precedence:
#   UMLJAVA_REACTIONS_DIR      the folder holding uml2java/ and java2uml/
#   VITRUV_CASESTUDIES_HOME    the Vitruv-CaseStudies checkout

set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
REPOSITORY="$(cd "$HERE/../.." && pwd)"
CONFIGS="$HERE/src/main/resources/configs"
REACTIONS_RELATIVE_PATH="umljava/src/main/reactions/tools/vitruv/applications/umljava"
CLASSPATH_FILE="$HERE/target/preprocessor-classpath.txt"

to_host_path() {
  if command -v cygpath > /dev/null 2>&1; then
    cygpath -m "$1"
  else
    printf '%s' "$1"
  fi
}

find_reactions_dir() {
  local candidate
  if [ -n "${UMLJAVA_REACTIONS_DIR:-}" ]; then
    if [ ! -d "$UMLJAVA_REACTIONS_DIR" ]; then
      echo "UMLJAVA_REACTIONS_DIR is set to $UMLJAVA_REACTIONS_DIR, which does not exist" >&2
      return 1
    fi
    (cd "$UMLJAVA_REACTIONS_DIR" && pwd)
    return 0
  fi

  for candidate in \
      "${VITRUV_CASESTUDIES_HOME:-}" \
      "$REPOSITORY/../Vitruv-CaseStudies" \
      "$REPOSITORY/../../Vitruv-CaseStudies" \
      "$HOME/IdeaProjects/Vitruv-CaseStudies" \
      "$HOME/projects/Vitruv-CaseStudies"; do
    [ -n "$candidate" ] || continue
    if [ -d "$candidate/$REACTIONS_RELATIVE_PATH" ]; then
      (cd "$candidate/$REACTIONS_RELATIVE_PATH" && pwd)
      return 0
    fi
  done

  echo "Could not find the Vitruv-CaseStudies checkout holding $REACTIONS_RELATIVE_PATH." >&2
  echo "Set VITRUV_CASESTUDIES_HOME to the checkout, or UMLJAVA_REACTIONS_DIR to the reactions folder." >&2
  return 1
}

if [ "$#" -gt 0 ]; then
  REQUESTED=("$@")
else
  REQUESTED=(1 2 3 4 5 6 7 8 9)
fi

REACTIONS="$(find_reactions_dir)"

if [ ! -d "$HERE/target/classes" ]; then
  echo "Building the preprocessor"
  (cd "$REPOSITORY" && ./mvnw -q -B -pl reactions/preprocessor -am install -DskipTests)
fi

if [ ! -s "$CLASSPATH_FILE" ]; then
  echo "Resolving the preprocessor classpath"
  (cd "$REPOSITORY" && ./mvnw -q -B -pl reactions/preprocessor dependency:build-classpath \
    -Dmdep.outputFile=target/preprocessor-classpath.txt)
fi

if command -v cygpath > /dev/null 2>&1; then
  CLASSPATH_SEPARATOR=";"
else
  CLASSPATH_SEPARATOR=":"
fi
CLASSPATH="$(to_host_path "$HERE/target/classes")${CLASSPATH_SEPARATOR}$(cat "$CLASSPATH_FILE")"

for number in "${REQUESTED[@]}"; do
  config="$CONFIGS/config${number}.json"
  if [ ! -f "$config" ]; then
    echo "No such configuration: $config" >&2
    exit 1
  fi

  echo "Preprocessing config${number}"
  java -cp "$CLASSPATH" tools.vitruv.reactions.preprocessor.Main \
    --config "$(to_host_path "$config")" \
    --reactions "$(to_host_path "$REACTIONS")"
done

echo "Wrote $(printf 'config%s-reactions ' "${REQUESTED[@]}")under $CONFIGS"
